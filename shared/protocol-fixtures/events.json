{
  "schema": "xm-audio-studio.protocol-events/1",
  "note": "expect == null means the payload must not decode to any event",
  "cases": [
    {
      "name": "init reply, 8 bytes (v2)",
      "source": "capture: WF-1000XM5 / XM5",
      "messageType": "command1",
      "payload": "01 00 03 00 00 00 00 00",
      "expect": {
        "event": "protocolInfo",
        "version": "v2"
      }
    },
    {
      "name": "init reply, 4 bytes (v1)",
      "source": "capture: WH-1000XM3 4.5.2",
      "messageType": "command1",
      "payload": "01 00 40 10",
      "expect": {
        "event": "protocolInfo",
        "version": "v1"
      }
    },
    {
      "name": "ambient 0x19 noise cancelling",
      "source": "layout: XM6 fw 3.x (Anneo22 captures)",
      "messageType": "command1",
      "payload": "67 19 01 01 00 00 0c 00 00",
      "expect": {
        "event": "ambientSound",
        "mode": "noiseCancelling",
        "focusOnVoice": false,
        "level": 12,
        "subtype": 25,
        "isUpdate": true,
        "hasWindNoiseByte": false
      }
    },
    {
      "name": "ambient 0x19 notify, ambient + voice",
      "source": "layout: XM6 fw 3.x",
      "messageType": "command1",
      "payload": "69 19 01 01 01 01 14 01 00",
      "expect": {
        "event": "ambientSound",
        "mode": "ambientSound",
        "focusOnVoice": true,
        "level": 20,
        "subtype": 25,
        "isUpdate": true,
        "hasWindNoiseByte": false
      }
    },
    {
      "name": "ambient 0x17 zero-update placeholder",
      "source": "XM6 fw 3.0.0 behaviour",
      "messageType": "command1",
      "payload": "67 17 00 00 00 00 00 00",
      "expect": {
        "event": "ambientSound",
        "mode": "off",
        "focusOnVoice": false,
        "level": 0,
        "subtype": 23,
        "isUpdate": false,
        "hasWindNoiseByte": true
      }
    },
    {
      "name": "ambient 0x17 seven bytes, effect off",
      "source": "capture: WF-1000XM5",
      "messageType": "command1",
      "payload": "67 17 01 00 01 00 14",
      "expect": {
        "event": "ambientSound",
        "mode": "off",
        "focusOnVoice": false,
        "level": 20,
        "subtype": 23,
        "isUpdate": true,
        "hasWindNoiseByte": false
      }
    },
    {
      "name": "ambient 0x15 noise cancelling",
      "source": "reference layout",
      "messageType": "command1",
      "payload": "67 15 01 01 00 00 14",
      "expect": {
        "event": "ambientSound",
        "mode": "noiseCancelling",
        "focusOnVoice": false,
        "level": 20,
        "subtype": 21,
        "isUpdate": true,
        "hasWindNoiseByte": false
      }
    },
    {
      "name": "ambient unknown subtype rejected",
      "source": "negative",
      "messageType": "command1",
      "payload": "67 99 01 01 00 00 14",
      "expect": null
    },
    {
      "name": "ambient 0x19 with wrong length rejected",
      "source": "negative",
      "messageType": "command1",
      "payload": "67 19 01 01 00 00 0c",
      "expect": null
    },
