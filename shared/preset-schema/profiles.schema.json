{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andru1989/xm-audio-studio/shared/preset-schema/profiles.schema.json",
  "title": "XM Audio Studio profile export",
  "description": "Version 2 adds the optional per-profile 'scene' (headphone settings beyond the EQ). Version 1 files stay valid and importable; the apps write version 2.",
  "type": "object",
  "required": [
    "format",
    "version",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "xm-audio-studio.profiles"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "exportedAt": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "model",
        "deviceEq"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "enum": [
            "device-preset",
            "measured",
            "subjective",
            "user"
          ],
          "description": "device-preset: a Sony built-in preset; measured: derived from an acoustic measurement (e.g. AutoEq); subjective: designed by taste; user: created by the user"
        },
        "model": {
          "enum": [
            "mdr-1000x",
            "wh-1000xm2",
            "wh-1000xm3",
            "wh-1000xm4",
            "wh-1000xm5",
            "wh-1000xm6"
          ]
        },
        "deviceEq": {
          "type": "object",
          "additionalProperties": false,
          "description": "Exactly one of presetCode (select a Sony preset) or steps (custom curve, low band first, device steps).",
          "properties": {
            "presetCode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "clearBass": {
              "type": "integer"
            }
          }
        },
        "scene": {
          "$ref": "#/$defs/scene"
        },
        "sourceCurve": {
          "description": "The parametric curve the steps were fitted to (AutoEq import). Kept for comparison and the future DSP mode.",
          "type": "object",
          "required": [
            "preampDb",
            "filters"
          ],
          "additionalProperties": false,
          "properties": {
            "preampDb": {
              "type": "number"
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "frequency",
                  "gainDb",
                  "q"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "peaking",
                      "lowShelf",
                      "highShelf"
                    ]
                  },
                  "frequency": {
                    "type": "number"
                  },
                  "gainDb": {
                    "type": "number"
                  },
                  "q": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "attribution": {
              "type": "string"
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "scene": {
      "description": "Headphone settings captured with the profile (version 2+). Every field is optional: only what the headphones reported is captured. The apps reject a field the profile's model does not support (capabilities in shared/protocol-spec/models.json).",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "noiseControl": {
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "noiseCancelling",
                "ambientSound",
                "off"
              ]
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Ambient sound level; also limited by the model's ambientLevelRange."
            },
            "focusOnVoice": {
              "type": "boolean"
            }
          }
        },
        "listeningMode": {
          "enum": [
            "standard",
            "backgroundMusic",
            "cinema"
          ]
        },
        "bgmRoomSize": {
          "enum": [
            "small",
            "middle",
            "large"
          ]
        },
        "speakToChat": {
          "type": "boolean"
        },
        "pauseWhenTakenOff": {
          "type": "boolean"
        },
        "autoPowerOff": {
          "enum": [
            "whenTakenOff",
            "off"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "profiles": {
            "items": {
              "not": {
                "required": [
                  "scene"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
