<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ (API 31): runtime permission to talk to already-paired devices.
         The app never scans, so BLUETOOTH_SCAN is not requested. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 8-11: legacy install-time permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <application
        android:name=".XmAudioStudioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XmAudioStudio"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press on the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Etapa 6: platform surfaces. They share the app's process-wide session; no foreground
             service (docs/android/BACKGROUND.md). -->
        <service
            android:name=".platform.NoiseControlTileService"
            android:exported="true"
            android:icon="@drawable/ic_noise_cancelling"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".platform.NoiseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/noise_widget_info" />
        </receiver>

        <!-- Widget buttons only (explicit PendingIntents); never reachable from other apps. -->
        <receiver
            android:name=".platform.NoiseControlReceiver"
            android:exported="false" />
    </application>
</manifest>
