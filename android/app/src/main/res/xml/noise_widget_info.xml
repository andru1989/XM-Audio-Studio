<?xml version="1.0" encoding="utf-8"?>
<!-- No periodic updates (updatePeriodMillis 0): the app pushes changes while its process lives and
     the launcher keeps the last pushed views otherwise. See docs/android/BACKGROUND.md. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_noise_control"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_noise_control"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
