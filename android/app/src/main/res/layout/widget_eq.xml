<?xml version="1.0" encoding="utf-8"?>
<!-- Equalizer widget (RemoteViews). Texts are what the widget picker previews; EqWidgetProvider
     replaces all of them. The list comes with the views on Android 12+, from EqWidgetService before. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/eq_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@string/eq_widget_prev"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_on_surface" />

        <LinearLayout
            android:id="@+id/eq_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eq_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/eq_widget_preview_title"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eq_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/eq_widget_preview_status"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/eq_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@string/eq_widget_next"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_on_surface" />
    </LinearLayout>

    <ListView
        android:id="@+id/eq_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/eq_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/eq_widget_empty"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
