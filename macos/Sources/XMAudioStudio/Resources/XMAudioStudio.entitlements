<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is not sandboxed. Under the hardened runtime (build_app.sh signs with
	     -o runtime) audio input is denied unless this entitlement is present; the
	     Core Audio process tap of the optional local DSP equalizer needs it. The user
	     is still asked for the "System Audio Recording" permission
	     (NSAudioCaptureUsageDescription) the first time the DSP is turned on. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
